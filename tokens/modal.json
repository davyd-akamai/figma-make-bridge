{
  "component": {
    "modal": {
      "background": {
        "value": "{alias.background.normal}",
        "type": "color"
      },
      "icon": {
        "value": "{alias.content.icon.primary.default}",
        "type": "color"
      },
      "text": {
        "default": {
          "value": "{alias.content.text.primary.default}",
          "type": "color"
        },
        "description": {
          "value": "{alias.content.text.secondary.default}",
          "type": "color"
        }
      },
      "overlay": {
        "value": "{alias.background.overlay}",
        "type": "color",
        "description": "Backdrop dimming behind the panel \u2014 same alias token Drawer uses (Figma's Modal node has no backdrop of its own; the alias is described as page dimming when the modal is active)"
      },
      "elevation": {
        "value": "{alias.elevation.l}",
        "type": "boxShadow",
        "description": "Shadow L, matches the Modal node's drop shadows (y16/blur32 + y4/blur8)"
      }
    }
  }
}
